# GEMINI_API_KEY: Optional if AI capabilities are requested
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Cloud Run / deployment host URL
APP_URL="MY_APP_URL"

# Supabase Connection Configuration (Required for live database & storage)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"

# Zion Admin Preview Passcode for #/admin (defaults to zion2026)
VITE_ADMIN_PASSCODE="zion2026"
