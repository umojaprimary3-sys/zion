# Copy to .env (never commit .env). Only PUBLIC values belong here.
# Supabase → Project Settings → API
VITE_SUPABASE_URL="https://YOUR-PROJECT-ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"

# OPTIONAL — local development only (npm run dev). Ignored in production builds.
# VITE_ADMIN_PASSCODE="choose-a-local-passcode"

# OPTIONAL — URL of your email-sending API/Edge Function (Admin → Email). Leave blank until you have one.
# VITE_API_URL=""
